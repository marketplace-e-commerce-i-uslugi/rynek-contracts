{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rynek.pl/contracts/events/channel.created.schema.json",
  "title": "channel.created",
  "description": "Kanał utworzony. Zastępuje PUT /internal/users/{id}/channel (channel -> identity); słuchają też search i feed (§17). Producent: channel-service. Temat Kafka: channel.created, klucz wiadomości: aggregateId.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "aggregateId",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Unikalny; konsument deduplikuje po nim (dostarczanie at-least-once)."
    },
    "eventType": {
      "const": "channel.created"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid",
      "description": "Id agregatu (zamówienie, rezerwacja, płatność, kanał, opinia); klucz partycji."
    },
    "payload": {
      "type": "object",
      "required": [
        "channelId",
        "ownerId",
        "handle"
      ],
      "additionalProperties": false,
      "properties": {
        "channelId": {
          "type": "string",
          "format": "uuid"
        },
        "ownerId": {
          "type": "string",
          "format": "uuid"
        },
        "handle": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
